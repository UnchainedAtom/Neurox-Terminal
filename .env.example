# Home Assistant Configuration
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_access_token_here

# Dashboard Defaults
DEFAULT_ROOM=home
DEFAULT_DASHBOARD_MODE=lighting

# Light Entity Configuration
LIGHT_ENTITY_ID=light.overhead_light
# Optional comma-separated list. Leave blank to show all Home Assistant lights.
LIGHT_ENTITY_IDS=

# Scene Entity Configuration
SCENE_PARTY_MODE=scene.party_mode
SCENE_MATRIX_GREEN=scene.matrix_green
SCENE_RED_ALERT=scene.red_alert
SCENE_BLACKOUT=scene.blackout
SCENE_NORMAL=scene.normal
SCENE_MAINFRAME_BREACH=scene.red_alert

# Media configuration
MEDIA_PATH=/home/pi/media.mp4
# Optional comma-separated list. Leave blank to show all Home Assistant media players.
MEDIA_PLAYER_ENTITY_IDS=
SPOTIFY_MEDIA_PLAYER_ENTITY_ID=media_player.spotify
PLEX_MEDIA_PLAYER_ENTITY_ID=
SPOTIFY_DEFAULT_SOURCE=
SPOTIFY_PARTY_PLAYLIST_URI=
SPOTIFY_AMBIENT_PLAYLIST_URI=

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000

# Demo/Mock Mode
# Set to True for testing without Home Assistant
DEMO_MODE=True
