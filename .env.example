# Home Assistant Configuration
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_access_token_here

# Dashboard Defaults
DEFAULT_ROOM=home
DEFAULT_DASHBOARD_MODE=lighting

# Light Entity Configuration
LIGHT_ENTITY_ID=light.overhead_light
# Optional comma-separated list. Leave blank to show all Home Assistant lights.
LIGHT_ENTITY_IDS=light.art_display,light.dnd_room,light.entryway,light.kitchen_table,light.laundry_room_entryway,light.living_room_lamp,light.living_room_station_lamp,switch.tp_link_smart_plug_d528_lights1,switch.tp_link_smart_plug_d528_lights2
BACKYARD_LIGHT_ENTITY_IDS=switch.tp_link_smart_plug_d528_lights1,switch.tp_link_smart_plug_d528_lights2

# Scene Entity Configuration
SCENE_HOME_2077_CITY=scene.home_2077_city
SCENE_BLADERUNNER_ORANGE=scene.home_bladerunner_orange
SCENE_ENERGIZE=scene.home_energize
SCENE_CLUB=scene.home_club
SCENE_MATRIX=scene.home_matrix
SCENE_NOSTROMO_ALARM=scene.home_nostromo_alarm
SCENE_RELAX=scene.home_relax
HUE_DYNAMIC_SCENES=True
HUE_SCENE_BRIGHTNESS=
HUE_SCENE_SPEED=
HUE_SCENE_TRANSITION=
SCENE_HOME_2077_CITY_SPOTIFY_URI=
SCENE_BLADERUNNER_ORANGE_SPOTIFY_URI=
SCENE_ENERGIZE_SPOTIFY_URI=
SCENE_CLUB_SPOTIFY_URI=
SCENE_MATRIX_SPOTIFY_URI=
SCENE_NOSTROMO_ALARM_SPOTIFY_URI=
SCENE_RELAX_SPOTIFY_URI=

# Media configuration
MEDIA_PATH=/home/pi/media.mp4
# Optional comma-separated list. Leave blank to show all Home Assistant media players.
MEDIA_PLAYER_ENTITY_IDS=
SPOTIFY_MEDIA_PLAYER_ENTITY_ID=media_player.spotify
PLEX_MEDIA_PLAYER_ENTITY_ID=
SPOTIFY_DEFAULT_SOURCE=
SPOTIFY_PARTY_PLAYLIST_URI=
SPOTIFY_AMBIENT_PLAYLIST_URI=

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8000

# Demo/Mock Mode
# Set to True for testing without Home Assistant
DEMO_MODE=True
